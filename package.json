{
  "name": "kenji-hilasaca-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Professional portfolio for Kenji Hilasaca, a Data & AI Engineer based in Leeds, UK.",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro check && ASTRO_TELEMETRY_DISABLED=1 astro build",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "check:links": "node scripts/check-links.mjs",
    "generate:og": "node scripts/generate-og.mjs",
    "audit": "ASTRO_TELEMETRY_DISABLED=1 node scripts/audit.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource/ibm-plex-sans": "^5.2.7",
    "@fontsource/source-serif-4": "^5.2.8",
    "astro": "^7.1.6"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "chrome-launcher": "^1.2.1",
    "lighthouse": "^13.4.1",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "sharp": "^0.35.3",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "sharp@0.35.3": true
  }
}
