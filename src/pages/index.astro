---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import ProjectCard from "../components/ProjectCard.astro";
import profileImage from "../assets/kenji-profile-square.jpg";
import { projects, site } from "../data/site";

const featuredOrder = [
  "agentic-support-intelligence",
  "align-and-shine",
  "exchange-rate-forecasting",
];
const featured = projects
  .filter((project) => project.featured)
  .sort(
    (a, b) => featuredOrder.indexOf(a.slug) - featuredOrder.indexOf(b.slug),
  );
const links = [
  { href: `mailto:${site.email}`, label: "Email", icon: "mail" },
  { href: site.linkedin, label: "LinkedIn", icon: "linkedin" },
  { href: site.github, label: "GitHub", icon: "github" },
  { href: site.cv, label: "CV (PDF)", icon: "file-text", strong: true },
] as const;
---

<BaseLayout>
  <div class="container home">
    <section class="intro">
      <aside class="profile">
        <Image
          class="profile__photo"
          src={profileImage}
          alt={site.name}
          width={220}
          height={220}
          densities={[1, 2, 3]}
          format="webp"
          loading="eager"
        />
        <div>
          <h1 class="profile__name">{site.name}</h1>
          <p class="profile__role">{site.role} · {site.locationShort}</p>
        </div>
        <ul class="profile__links">
          {
            links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class:list={{ strong: "strong" in link && link.strong }}
                >
                  <Icon name={link.icon} />
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </aside>

      <div class="about">
        <p class="about__roles">{site.rolesLine}</p>
        <div class="bio">
          <p>
            I'm a data and AI engineer focused on reliable data pipelines,
            applied machine learning and multilingual NLP. As a Research
            Assistant at the University of Leeds, I build GPU-backed pipelines
            for multilingual corpora, including <a href="/work/align-and-shine/"
              >Align and Shine</a
            >, published at <a href="/publications/">LREC 2026</a>.
          </p>
          <p>
            I hold an MSc in Data Science &amp; Analytics with Distinction from
            Leeds and a BSc in Mechatronic Engineering from UNI in Peru. My path
            to data wasn't linear: I co-founded <a href="/experience/"
              >PlayTec</a
            >, a software and tech-education company, then moved into analytics
            at INDRA and data engineering for corporate banking at <a
              href="/experience/">BBVA</a
            >. Building products taught me to start from the problem, not the
            tool.
          </p>
          <p>
            Outside of work, I was part of the winning team at <a
              href="https://issuu.com/sociedadmineroenergetica/docs/snmpe-memoria-2016/135"
              >Peru's Mining &amp; Energy Hackathon</a
            >, competed in the ARLISS student satellite challenge, and still
            play <a
              href="https://soundcloud.com/luis-kenji-hilasak/tiempo-al-tiempo-1"
              >folk music from Juliaca</a
            >.
          </p>
          <p>
            Open to Data Engineering, ML Engineering and applied AI roles in the
            UK. Connect with me on <a href={site.linkedin}>LinkedIn</a>.
          </p>
        </div>
      </div>
    </section>

    <section class="selected" aria-labelledby="selected-work">
      <div class="selected__head">
        <h2 id="selected-work">Selected work</h2>
        <a href="/work/">All projects →</a>
      </div>
      <div class="selected__grid stagger">
        {featured.map((project) => <ProjectCard project={project} />)}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .home {
    padding-block: var(--space-7) var(--space-6);
  }

  .intro {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-7);
  }

  .profile {
    display: flex;
    flex: 1 1 240px;
    flex-direction: column;
    gap: 1.25rem;
    max-width: 260px;
  }

  .profile :global(.profile__photo) {
    width: 220px;
    height: 220px;
    border-radius: 50%;
    object-fit: cover;
    object-position: 50% 40%;
  }

  .profile__name {
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.2;
  }

  .profile__role {
    margin: 0.25rem 0 0;
    color: var(--muted);
    font-size: 0.9375rem;
  }

  .profile__links {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-size: 0.9375rem;
  }

  .profile__links a {
    display: flex;
    min-height: 36px;
    gap: 0.625rem;
    align-items: center;
    text-decoration: none;
  }

  .profile__links a:hover {
    text-decoration: underline;
  }

  .profile__links .strong {
    font-weight: 600;
  }

  .about {
    flex: 999 1 520px;
    min-width: 0;
    max-width: 680px;
  }

  .about__roles {
    margin-bottom: var(--space-5);
    color: #3d4441;
    font-size: 1.1875rem;
    line-height: 1.5;
  }

  .selected {
    margin-top: var(--space-8);
  }

  .selected__head {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: var(--space-4);
  }

  .selected__head h2 {
    font-size: 1.75rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .selected__head a {
    font-size: 0.9375rem;
    font-weight: 500;
  }

  .selected__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
  }

  @media (max-width: 60rem) {
    .selected__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 40rem) {
    .home {
      padding-top: var(--space-5);
    }

    .intro {
      gap: var(--space-5);
    }

    .profile {
      max-width: none;
    }

    .profile :global(.profile__photo) {
      width: 160px;
      height: 160px;
    }
  }
</style>
