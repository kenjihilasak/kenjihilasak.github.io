---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import { education, experience, site } from "../data/site";
---

<BaseLayout
  title="Experience — Kenji Hilasaca"
  description="Kenji Hilasaca's experience across data engineering, applied machine learning, banking, consulting and software delivery."
>
  <div class="container page">
    <div class="page__head">
      <h1 class="page-title">Experience</h1>
      <a class="cv" href={site.cv}><Icon name="file-text" /> Download CV</a>
    </div>

    <ol class="timeline">
      {
        experience.map((item) => (
          <li class="entry">
            <p class="entry__period">{item.period}</p>
            <div>
              <h2 class="entry__role">{item.role}</h2>
              <p class="entry__org">{item.organisation}</p>
              <p class="entry__summary">{item.summary}</p>
              <ul class="tag-list" aria-label="Skills">
                {item.tags.map((tag) => (
                  <li>{tag}</li>
                ))}
              </ul>
            </div>
          </li>
        ))
      }
    </ol>

    <h2 class="section-title">Education</h2>
    <ol class="timeline">
      {
        education.map((item) => (
          <li class="entry">
            <p class="entry__period">{item.period}</p>
            <div>
              <h3 class="entry__role">{item.degree}</h3>
              <p class="entry__org">{item.institution}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</BaseLayout>

<style>
  .page {
    max-width: 52rem;
    padding-block: var(--space-7) var(--space-6);
  }

  .page__head {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    align-items: baseline;
    justify-content: space-between;
  }

  .cv {
    display: inline-flex;
    min-height: 44px;
    gap: 0.5rem;
    align-items: center;
    font-weight: 600;
  }

  .timeline {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .entry {
    display: grid;
    grid-template-columns: 10rem minmax(0, 1fr);
    gap: var(--space-4);
    padding-block: var(--space-4);
    border-top: 1px solid var(--line-solid);
  }

  .entry__period {
    margin: 0;
    color: var(--muted);
    font-size: 0.9375rem;
  }

  .entry__role {
    font-family: var(--font-sans);
    font-size: 1.1875rem;
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1.4;
  }

  .entry__org {
    margin: 0.125rem 0 0.75rem;
    color: var(--teal);
    font-weight: 500;
  }

  .entry__summary {
    color: #3d4441;
  }

  .section-title {
    margin: var(--space-6) 0 var(--space-3);
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  @media (max-width: 40rem) {
    .entry {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }
  }
</style>
