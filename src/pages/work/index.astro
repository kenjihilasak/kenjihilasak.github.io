---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import ArrowIcon from "../../components/ArrowIcon.astro";
import { projects } from "../../data/site";

const projectOrder = [
  "uol-finance-ai-assistant",
  "align-and-shine",
  "late-refill-risk",
  "exchange-rate-forecasting",
  "agentic-support-intelligence",
];
const orderedProjects = [...projects].sort(
  (first, second) =>
    projectOrder.indexOf(first.slug) - projectOrder.indexOf(second.slug),
);
---

<BaseLayout
  title="Selected Work — Kenji Hilasaca"
  description="Selected data engineering, machine-learning and multilingual NLP projects by Kenji Hilasaca."
>
  <header class="page-hero">
    <div class="container">
      <p class="eyebrow">Selected work</p>
      <h1>Technical depth, made legible.</h1>
      <p class="lede">
        Projects chosen to show how I frame problems, build evidence and decide
        what is—and is not—ready for real use.
      </p>
    </div>
  </header>

  <section class="section section--white">
    <div class="container">
      <div class="projects">
        {
          orderedProjects.map((project, index) => (
            <ProjectCard project={project} index={index} headingLevel="h2" />
          ))
        }
      </div>
    </div>
  </section>

  <section class="section earlier-work">
    <div class="container earlier-work__grid">
      <div>
        <p class="eyebrow">Earlier engineering work</p>
        <span aria-hidden="true">2015</span>
      </div>
      <article>
        <h2>
          Multi-robot Exploration and Mapping Strategy in Underground Mines by
          Behavior Control
        </h2>
        <p>
          An early robotics project on coordination, mapping and sensor-based
          navigation for high-risk mining environments, published by Springer.
        </p>
        <a
          class="text-link"
          href="https://doi.org/10.1007/978-3-319-09858-6_10"
        >
          View publication
          <ArrowIcon direction="up-right" />
        </a>
      </article>
    </div>
  </section>

  <section class="section principles">
    <div class="container">
      <SectionHeading
        eyebrow="Engineering principles"
        title="What I want the work to prove."
        intro="A portfolio should expose judgement—not only polished outcomes."
      />
      <div class="principles__grid">
        <article>
          <span>01</span>
          <h3>Reproducibility</h3>
          <p>
            Clear inputs, versioned code, explicit dependencies and a path from
            raw data to result.
          </p>
        </article>
        <article>
          <span>02</span>
          <h3>Evaluation</h3>
          <p>
            Baselines, untouched test data and metrics that match the decision
            the system needs to support.
          </p>
        </article>
        <article>
          <span>03</span>
          <h3>Operational thinking</h3>
          <p>
            Runtime, lineage, failure modes and maintainability considered
            alongside model performance.
          </p>
        </article>
      </div>
      <a class="text-link" href="https://github.com/kenjihilasak">
        Browse all repositories
        <ArrowIcon direction="up-right" />
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .projects {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-5);
  }

  .principles__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-block: 1px solid var(--line);
  }

  .earlier-work__grid {
    display: grid;
    grid-template-columns: 0.38fr 1fr;
    gap: var(--space-8);
    padding-block: var(--space-6);
    border-block: 1px solid var(--line);
  }

  .earlier-work__grid > div > span {
    display: block;
    margin-top: var(--space-5);
    color: var(--brick);
    font-family: var(--font-serif);
    font-size: var(--step-4);
  }

  .earlier-work h2 {
    max-width: 24ch;
    font-size: var(--step-3);
  }

  .earlier-work article > p {
    max-width: 44rem;
    margin-top: var(--space-4);
    color: var(--muted);
  }

  .principles article {
    padding: var(--space-5);
    border-right: 1px solid var(--line);
  }

  .principles article:first-child {
    padding-left: 0;
  }

  .principles article:last-child {
    padding-right: 0;
    border-right: 0;
  }

  .principles article > span {
    color: var(--brick);
    font-size: var(--step--1);
    font-weight: 600;
  }

  .principles h3 {
    margin-block: var(--space-5) var(--space-3);
    font-size: var(--step-2);
  }

  .principles p {
    margin: 0;
    color: var(--muted);
  }

  .text-link {
    display: inline-flex;
    gap: 0.45rem;
    align-items: center;
    margin-top: var(--space-6);
    color: var(--ink);
    font-weight: 600;
    text-decoration: none;
  }

  @media (max-width: 58rem) {
    .projects,
    .principles__grid,
    .earlier-work__grid {
      grid-template-columns: 1fr;
    }

    .principles article,
    .principles article:first-child,
    .principles article:last-child {
      padding: var(--space-5) 0;
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }
  }
</style>
