---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { projects, site } from "../../data/site";

const projectOrder = [
  "agentic-support-intelligence",
  "align-and-shine",
  "exchange-rate-forecasting",
  "late-refill-risk",
];
const orderedProjects = [...projects].sort(
  (first, second) =>
    projectOrder.indexOf(first.slug) - projectOrder.indexOf(second.slug),
);
---

<BaseLayout
  title="Projects — Kenji Hilasaca"
  description="Data engineering, applied machine learning and multilingual NLP projects by Kenji Hilasaca."
>
  <div class="container page">
    <h1 class="page-title">Projects</h1>
    <div class="projects">
      {
        orderedProjects.map((project) => (
          <ProjectCard project={project} variant="full" headingLevel="h2" />
        ))
      }
    </div>
    <p class="more">
      More on <a href={site.github}>GitHub</a>.
    </p>
  </div>
</BaseLayout>

<style>
  .page {
    padding-block: var(--space-7) var(--space-6);
  }

  .projects {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .more {
    margin-top: var(--space-5);
    color: var(--muted);
  }

  @media (max-width: 52rem) {
    .projects {
      grid-template-columns: 1fr;
    }
  }
</style>
