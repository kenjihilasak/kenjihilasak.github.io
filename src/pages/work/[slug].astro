---
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArrowIcon from "../../components/ArrowIcon.astro";
import AgenticSupportWorkbench from "../../components/AgenticSupportWorkbench.astro";
import lrecImage from "../../assets/lrec-2026.jpg";
import { projects } from "../../data/site";
import { caseStudies } from "../../data/caseStudies";

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project, study: caseStudies[project.slug] },
  }));
}

const { project, study } = Astro.props;
const isAlignAndShine = project.slug === "align-and-shine";
const isAgenticSupport = project.slug === "agentic-support-intelligence";

const links = [
  project.demo && !isAgenticSupport
    ? { label: "Live demo", href: project.demo }
    : null,
  project.paper ? { label: "Paper", href: project.paper } : null,
  project.preprint ? { label: "arXiv", href: project.preprint } : null,
  project.report ? { label: "Dissertation (PDF)", href: project.report } : null,
  { label: "GitHub", href: project.github },
].filter((link): link is { label: string; href: string } => Boolean(link));

const overview = [
  { label: "Problem", text: study.problem },
  { label: "My role", text: study.role },
  { label: "Result", text: study.result },
];

const publicationSchema = isAlignAndShine
  ? {
      "@context": "https://schema.org",
      "@type": "ScholarlyArticle",
      headline:
        "Align and Shine: Building High-Quality Sentence-Aligned Corpora for Multilingual Text Simplification",
      author: [
        { "@type": "Person", name: "Kenji Hilasaca" },
        { "@type": "Person", name: "Nouran Khallaf" },
        { "@type": "Person", name: "Serge Sharoff" },
      ],
      datePublished: "2026",
      url: project.paper,
      sameAs: project.preprint,
    }
  : null;
---

<BaseLayout
  title={`${project.title} — Kenji Hilasaca`}
  description={study.summary}
>
  {
    publicationSchema && (
      <script
        type="application/ld+json"
        is:inline
        set:html={JSON.stringify(publicationSchema)}
      />
    )
  }

  <div class="container case">
    <a class="back" href="/work/">← All projects</a>

    <header class="head">
      <p class="tag">{project.eyebrow}</p>
      <h1 class="page-title">{project.title}</h1>
      <p class="summary">{study.summary}</p>
      <ul class="tag-list" aria-label="Technologies">
        {project.tags.map((tag) => <li>{tag}</li>)}
      </ul>
      <p class="links">
        {
          links.map((link) => (
            <a href={link.href}>
              {link.label} <ArrowIcon direction="up-right" />
            </a>
          ))
        }
      </p>
    </header>
  </div>

  {isAgenticSupport && <AgenticSupportWorkbench />}

  <div class="container case">
    <section class="cards stagger" aria-label="Overview">
      {
        overview.map((item) => (
          <article class="card">
            <h2 class="label">{item.label}</h2>
            <p>{item.text}</p>
          </article>
        ))
      }
    </section>

    <section class="metrics stagger" aria-label="Key numbers">
      {
        study.metrics.map((metric) => (
          <div class="card metric">
            <strong>{metric.value}</strong>
            <span>{metric.label}</span>
          </div>
        ))
      }
    </section>

    {
      isAlignAndShine && (
        <figure class="photo">
          <Image
            src={lrecImage}
            alt="Kenji Hilasaca beside the LREC 2026 welcome display in Palma"
            widths={[640, 960, 1120]}
            sizes="(max-width: 1120px) 100vw, 1120px"
            format="webp"
          />
          <figcaption>Presenting at the BUCC workshop, LREC 2026.</figcaption>
        </figure>
      )
    }

    <section class="block">
      <h2 class="section-title">How it works</h2>
      <ol class="flow">
        {study.pipeline.map((step) => <li>{step}</li>)}
      </ol>
    </section>

    <section class="block">
      <h2 class="section-title">Key decisions</h2>
      <ul class="decisions stagger">
        {
          study.decisions.map((item) => (
            <li>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <p class="next"><strong>Next step:</strong> {study.next}</p>
  </div>
</BaseLayout>

<style>
  .case {
    padding-top: var(--space-5);
  }

  .case + .case,
  :global(.triage) + .case {
    padding-top: var(--space-6);
  }

  .back {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    font-size: 0.9375rem;
    text-decoration: none;
  }

  .head {
    max-width: 46rem;
    padding-bottom: var(--space-5);
  }

  .tag {
    margin: var(--space-3) 0 0.5rem;
    color: var(--teal);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .summary {
    color: #3d4441;
    font-size: 1.1875rem;
    line-height: 1.55;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.25rem;
    margin: var(--space-3) 0 0;
    font-weight: 500;
  }

  .links a {
    display: inline-flex;
    min-height: 44px;
    gap: 0.35rem;
    align-items: center;
    text-decoration: none;
  }

  .card {
    padding: var(--space-4);
    border: 1px solid var(--line-solid);
    border-radius: 8px;
    background: var(--white);
  }

  .cards,
  .metrics {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .metrics {
    margin-top: var(--space-4);
  }

  .label {
    margin-bottom: 0.5rem;
    color: var(--teal);
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .card p {
    margin: 0;
    color: #3d4441;
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .metric strong {
    display: block;
    color: var(--teal);
    font-family: var(--font-serif);
    font-size: 2.25rem;
    font-weight: 600;
    line-height: 1.1;
  }

  .metric span {
    color: var(--muted);
    font-size: 0.9375rem;
  }

  .photo {
    margin: var(--space-6) 0 0;
  }

  .photo :global(img) {
    width: 100%;
    height: auto;
    border-radius: 8px;
  }

  .photo figcaption {
    margin-top: 0.5rem;
    color: var(--muted);
    font-size: 0.875rem;
  }

  .block {
    margin-top: var(--space-6);
  }

  .section-title {
    margin-bottom: var(--space-3);
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .flow {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }

  .flow li {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    font-size: 0.9375rem;
    font-weight: 500;
    counter-increment: step;
  }

  .flow li {
    padding: 0.5rem 0.875rem;
    border: 1px solid var(--line-solid);
    border-radius: 999px;
    background: var(--white);
  }

  .flow li::before {
    color: var(--teal);
    content: counter(step);
    font-weight: 600;
  }

  .decisions {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .decisions li {
    padding-top: var(--space-3);
    border-top: 2px solid var(--teal);
  }

  .decisions h3 {
    margin-bottom: 0.375rem;
    font-family: var(--font-sans);
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1.4;
  }

  .decisions p {
    margin: 0;
    color: #3d4441;
    font-size: 0.9375rem;
  }

  .next {
    margin: var(--space-6) 0 0;
    padding-top: var(--space-4);
    border-top: 1px solid var(--line-solid);
    color: #3d4441;
  }

  .next strong {
    color: var(--ink);
  }

  @media (max-width: 52rem) {
    .cards,
    .decisions {
      grid-template-columns: 1fr;
    }

    .metrics {
      gap: 0.5rem;
    }

    .metric {
      padding: var(--space-3) 0.75rem;
    }

    .metric strong {
      font-size: 1.375rem;
    }

    .metric span {
      font-size: 0.8125rem;
    }
  }
</style>
