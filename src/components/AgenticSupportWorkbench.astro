---
const apiBase = (
  import.meta.env.PUBLIC_AGENTIC_SUPPORT_API_URL ??
  import.meta.env.PUBLIC_UOL_FINANCE_API_URL ??
  ""
).replace(/\/$/, "");
const authTenantId = import.meta.env.PUBLIC_STAFF_AUTH_TENANT_ID ?? "";
const authClientId = import.meta.env.PUBLIC_STAFF_AUTH_WEB_CLIENT_ID ?? "";
const authScope = import.meta.env.PUBLIC_STAFF_AUTH_API_SCOPE ?? "";
const examples = [
  "A visitor lost the original meal receipt. What evidence can we accept?",
  "A student cannot submit coursework in Minerva and has not provided the module code.",
  "A student needs to change their address because someone is stalking them.",
];
---

<section
  class="section triage"
  id="live-workbench"
  data-api-base={apiBase}
  data-auth-tenant-id={authTenantId}
  data-auth-client-id={authClientId}
  data-auth-scope={authScope}
>
  <div class="container">
    <div class="triage__intro">
      <div>
        <p class="eyebrow">Staff enquiry workbench</p>
        <h2>From unstructured enquiry to a safe next action.</h2>
      </div>
      <p>
        Paste a synthetic enquiry. The system classifies it, applies
        deterministic routing, and only retrieves evidence when generation is
        allowed.
      </p>
    </div>
    <div class="triage__auth">
      <div>
        <strong id="auth-mode">Public demo mode</strong>
        <p id="auth-detail">
          Results are not stored. Use synthetic enquiries only.
        </p>
      </div>
      <button
        id="auth-button"
        type="button"
        class="button button--secondary"
        hidden
      >
        Sign in with Microsoft
      </button>
    </div>
    <div class="triage__layout">
      <form id="triage-form" class="triage__input">
        <label for="enquiry">Incoming enquiry</label>
        <textarea
          id="enquiry"
          maxlength="4000"
          rows="9"
          required
          placeholder="Paste a synthetic email or support enquiry…"></textarea>
        <div class="triage__examples">
          <span>Try an example</span>
          {
            examples.map((example, index) => (
              <button type="button" data-example={example}>
                0{index + 1}
              </button>
            ))
          }
        </div>
        <p class="triage__privacy">
          Demo data only. Do not enter names, contact details, health
          information or real incidents.
        </p>
        <button class="button" type="submit">Triage enquiry</button>
        <small id="triage-status"
          >{
            apiBase ? "Azure-backed API configured" : "API deployment pending"
          }</small
        >
      </form>
      <div id="triage-result" class="triage__result" aria-live="polite">
        <div class="empty-state">
          <span>Awaiting enquiry</span>
          <p>
            The structured classification, routing decision and cited draft will
            appear here.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import {
    PublicClientApplication,
    type AccountInfo,
  } from "@azure/msal-browser";

  const root = document.querySelector<HTMLElement>(".triage");
  if (root) {
    const apiBase = root.dataset.apiBase ?? "";
    const form = root.querySelector<HTMLFormElement>("#triage-form")!;
    const input = root.querySelector<HTMLTextAreaElement>("#enquiry")!;
    const result = root.querySelector<HTMLElement>("#triage-result")!;
    const status = root.querySelector<HTMLElement>("#triage-status")!;
    const submit = form.querySelector<HTMLButtonElement>(
      "button[type=submit]",
    )!;
    const authButton = root.querySelector<HTMLButtonElement>("#auth-button")!;
    const authMode = root.querySelector<HTMLElement>("#auth-mode")!;
    const authDetail = root.querySelector<HTMLElement>("#auth-detail")!;
    const tenantId = root.dataset.authTenantId ?? "";
    const clientId = root.dataset.authClientId ?? "";
    const scope = root.dataset.authScope ?? "";
    const authConfigured = Boolean(tenantId && clientId && scope);
    const redirectUri = `${window.location.origin}${window.location.pathname}`;
    const msal = authConfigured
      ? new PublicClientApplication({
          auth: {
            clientId,
            authority: `https://login.microsoftonline.com/${tenantId}`,
            redirectUri,
            postLogoutRedirectUri: redirectUri,
          },
          cache: { cacheLocation: "sessionStorage" },
        })
      : null;
    let account: AccountInfo | null = null;

    const renderAuth = () => {
      if (!authConfigured || !msal) return;
      authButton.hidden = false;
      if (account) {
        authMode.textContent = "Authenticated staff mode";
        authDetail.textContent = `${account.username ?? account.name ?? "Staff user"} · submissions are stored for review.`;
        authButton.textContent = "Sign out";
      } else {
        authMode.textContent = "Public demo mode";
        authDetail.textContent =
          "Results are not stored. Sign in to use the staff review queue.";
        authButton.textContent = "Sign in with Microsoft";
      }
    };

    if (msal) {
      await msal.initialize();
      account = msal.getAllAccounts()[0] ?? null;
      renderAuth();
      authButton.addEventListener("click", async () => {
        if (account) {
          await msal.logoutPopup({
            account,
            postLogoutRedirectUri: redirectUri,
          });
          account = null;
        } else {
          const login = await msal.loginPopup({ scopes: [scope] });
          account = login.account;
        }
        renderAuth();
      });
    }
    root
      .querySelectorAll<HTMLButtonElement>("[data-example]")
      .forEach((button) => {
        button.addEventListener("click", () => {
          input.value = button.dataset.example ?? "";
          input.focus();
        });
      });
    const row = (label: string, value: string) => {
      const div = document.createElement("div");
      const dt = document.createElement("dt");
      dt.textContent = label;
      const dd = document.createElement("dd");
      dd.textContent = value;
      div.append(dt, dd);
      return div;
    };
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!apiBase) {
        status.textContent =
          "Deploy the Railway API to activate this workbench.";
        return;
      }
      submit.disabled = true;
      status.textContent = "Classifying and applying routing policy…";
      try {
        const headers: Record<string, string> = {
          "Content-Type": "application/json",
        };
        let endpoint = `${apiBase}/v1/triage`;
        let body: { enquiry: string; persist?: boolean } = {
          enquiry: input.value.trim(),
          persist: false,
        };
        if (msal && account) {
          const token = await msal.acquireTokenSilent({
            account,
            scopes: [scope],
          });
          headers.Authorization = `Bearer ${token.accessToken}`;
          endpoint = `${apiBase}/v1/staff/triage`;
          body = { enquiry: input.value.trim() };
        }
        const response = await fetch(endpoint, {
          method: "POST",
          headers,
          body: JSON.stringify(body),
        });
        const payload = await response.json();
        if (!response.ok)
          throw new Error(payload.detail ?? "Triage unavailable");
        const classification = payload.decision.classification;
        const resultHeader = document.createElement("header");
        resultHeader.className = "result-header";
        const title = document.createElement("h3");
        title.textContent = classification.summary;
        const badge = document.createElement("span");
        badge.className = `decision decision--${payload.decision.action}`;
        badge.textContent = payload.decision.action.replaceAll("_", " ");
        resultHeader.append(badge, title);
        const dl = document.createElement("dl");
        dl.className = "result-facts";
        dl.append(
          row("Category", classification.category),
          row("Subcategory", classification.subcategory),
          row("Route", payload.decision.route_to.replaceAll("_", " ")),
          row(
            "Sensitive",
            classification.is_sensitive || payload.decision.rule_flags.length
              ? "Yes — generation blocked"
              : "No",
          ),
          row(
            "Missing information",
            classification.missing_info.length
              ? classification.missing_info.join(", ")
              : "None",
          ),
        );
        const reason = document.createElement("p");
        reason.className = "decision-reason";
        reason.textContent = payload.decision.reason;
        result.replaceChildren(resultHeader, dl, reason);
        if (payload.draft_response) {
          const draft = document.createElement("article");
          draft.className = "result-draft";
          const label = document.createElement("span");
          label.className = "result-label";
          label.textContent = "AI-assisted · staff review required";
          const heading = document.createElement("h4");
          heading.textContent = "Draft response";
          const text = document.createElement("p");
          text.textContent = payload.draft_response;
          draft.append(label, heading, text);
          if (payload.citations.length) {
            const evidenceHeading = document.createElement("h5");
            evidenceHeading.textContent = `Evidence (${payload.citations.length})`;
            const list = document.createElement("ul");
            list.className = "evidence-list";
            payload.citations.forEach((citation: any, index: number) => {
              const li = document.createElement("li");
              const details = document.createElement("details");
              const summary = document.createElement("summary");
              const marker = document.createElement("span");
              marker.textContent = String(index + 1).padStart(2, "0");
              const sourceName = document.createElement("strong");
              sourceName.textContent = citation.title;
              const sourceLocation = document.createElement("small");
              sourceLocation.textContent = `Page ${citation.page_number}`;
              summary.append(marker, sourceName, sourceLocation);
              const excerpt = document.createElement("blockquote");
              excerpt.textContent = citation.excerpt;
              const link = document.createElement("a");
              link.href = citation.page_url;
              link.target = "_blank";
              link.rel = "noreferrer";
              link.textContent = "Open original source ↗";
              details.append(summary, excerpt, link);
              li.append(details);
              list.append(li);
            });
            draft.append(evidenceHeading, list);
          }
          result.append(draft);
        }
        const resultStatus = payload.decision.allow_generation
          ? "Draft grounded in approved evidence"
          : "Safely routed without answer generation";
        status.textContent = account
          ? `${resultStatus} · saved for staff review`
          : resultStatus;
      } catch (error) {
        status.textContent =
          error instanceof Error ? error.message : "Request failed";
      } finally {
        submit.disabled = false;
      }
    });
  }
</script>

<style>
  .triage {
    background: var(--ink);
    color: var(--paper);
  }
  .triage__intro {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: var(--space-7);
    margin-bottom: var(--space-7);
  }
  .triage h2 {
    color: var(--paper);
    max-width: 18ch;
    font-size: var(--step-4);
  }
  .triage__intro > p,
  .triage__privacy,
  #triage-status {
    color: rgb(246 241 231 / 70%);
  }
  .triage__layout {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: var(--space-5);
  }
  .triage__auth {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-5);
    padding: var(--space-4);
    border: 1px solid rgb(246 241 231 / 20%);
    background: rgb(255 255 255 / 4%);
  }
  .triage__auth p {
    margin: 0.25rem 0 0;
    color: rgb(246 241 231 / 70%);
  }
  .triage__input,
  .triage__result {
    padding: var(--space-5);
    border: 1px solid rgb(246 241 231 / 20%);
    background: rgb(255 255 255 / 4%);
  }
  .triage label {
    display: block;
    margin-bottom: var(--space-2);
    font-weight: 700;
  }
  .triage textarea {
    width: 100%;
    padding: 1rem;
    resize: vertical;
    border: 1px solid rgb(246 241 231 / 30%);
    background: #101d22;
    color: var(--paper);
    font: inherit;
  }
  .triage__examples {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-block: var(--space-3);
  }
  .triage__examples button {
    width: 2.3rem;
    height: 2.3rem;
    border: 1px solid rgb(246 241 231 / 30%);
    border-radius: 50%;
    background: transparent;
    color: var(--paper);
    cursor: pointer;
  }
  #triage-status {
    display: block;
    margin-top: var(--space-3);
  }
  .decision {
    display: inline-block;
    padding: 0.35rem 0.65rem;
    background: var(--gold);
    color: var(--ink);
    text-transform: uppercase;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    border-radius: 999px;
  }
  .result-header {
    padding-bottom: var(--space-4);
    border-bottom: 1px solid rgb(246 241 231 / 14%);
  }
  .triage__result .result-header h3 {
    max-width: 30ch;
    margin: var(--space-3) 0 0;
    color: var(--paper);
    font-size: clamp(1.45rem, 3vw, 2.2rem);
    line-height: 1.08;
    letter-spacing: -0.025em;
  }
  .result-facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.65rem;
    margin-block: var(--space-4);
  }
  .result-facts div {
    min-width: 0;
    padding: 0.75rem;
    border: 1px solid rgb(246 241 231 / 12%);
    background: rgb(255 255 255 / 3%);
  }
  .result-facts div:last-child {
    grid-column: 1 / -1;
  }
  .result-facts dt {
    margin-bottom: 0.25rem;
    color: rgb(246 241 231 / 62%);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .result-facts dd {
    margin: 0;
    font-weight: 650;
    overflow-wrap: anywhere;
  }
  .decision-reason {
    margin: 0;
    padding: 0.85rem 1rem;
    border-left: 3px solid var(--gold);
    background: rgb(255 255 255 / 4%);
    color: rgb(246 241 231 / 82%);
  }
  .result-draft {
    margin-top: var(--space-5);
    padding-top: var(--space-4);
    border-top: 1px solid rgb(246 241 231 / 20%);
  }
  .result-label {
    color: var(--gold);
    font-size: 0.7rem;
    font-weight: 750;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .result-draft h4 {
    margin: 0.35rem 0 var(--space-3);
    color: var(--paper);
    font-size: 1.35rem;
  }
  .result-draft > p {
    margin: 0;
    color: rgb(246 241 231 / 84%);
    line-height: 1.7;
  }
  .result-draft h5 {
    margin: var(--space-5) 0 var(--space-2);
    color: var(--paper);
    font-size: 0.9rem;
  }
  .evidence-list {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .evidence-list details {
    border: 1px solid rgb(246 241 231 / 14%);
    background: rgb(255 255 255 / 3%);
  }
  .evidence-list summary {
    display: grid;
    grid-template-columns: 2rem 1fr auto;
    gap: 0.65rem;
    align-items: center;
    padding: 0.8rem;
    cursor: pointer;
  }
  .evidence-list summary span,
  .evidence-list summary small {
    color: rgb(246 241 231 / 56%);
  }
  .evidence-list blockquote {
    margin: 0;
    padding: 0.2rem 0.8rem 0.8rem 3.45rem;
    color: rgb(246 241 231 / 72%);
    font-size: 0.88rem;
    line-height: 1.55;
  }
  .evidence-list a {
    display: inline-block;
    margin: 0 0.8rem 0.8rem 3.45rem;
    font-size: 0.85rem;
  }
  .triage__result a {
    color: var(--gold);
  }
  @media (max-width: 800px) {
    .triage__intro,
    .triage__layout {
      grid-template-columns: 1fr;
    }
    .triage__auth {
      align-items: flex-start;
      flex-direction: column;
    }
    .result-facts {
      grid-template-columns: 1fr;
    }
    .result-facts div:last-child {
      grid-column: auto;
    }
    .evidence-list summary {
      grid-template-columns: 2rem 1fr;
    }
    .evidence-list summary small {
      grid-column: 2;
    }
    .evidence-list blockquote {
      padding-left: 0.8rem;
    }
    .evidence-list a {
      margin-left: 0.8rem;
    }
  }
</style>
