---
import ArrowIcon from "./ArrowIcon.astro";
import type { Project } from "../data/site";

interface Props {
  project: Project;
  /** compact: home cards. full: /work/ list with problem, result and stack. */
  variant?: "compact" | "full";
  headingLevel?: "h2" | "h3";
}

const { project, variant = "compact", headingLevel = "h3" } = Astro.props;
const Heading = headingLevel;
const full = variant === "full";
---

<article class:list={["project-card", { "project-card--full": full }]}>
  <p class="project-card__tag">{project.eyebrow}</p>
  <Heading class="project-card__title">{project.title}</Heading>
  {
    full ? (
      <div class="project-card__body">
        <p>{project.description}</p>
        <p>
          <strong>Result:</strong> {project.outcome}
        </p>
        <ul class="tag-list" aria-label="Stack">
          {project.tags.map((tag) => (
            <li>{tag}</li>
          ))}
        </ul>
      </div>
    ) : (
      <p class="project-card__body">{project.outcome}</p>
    )
  }
  <div class="project-card__links">
    <a href={`/work/${project.slug}/`}>
      Case study <ArrowIcon />
    </a>
    {
      full && project.demo && (
        <a href={project.demo}>
          Live demo <ArrowIcon />
        </a>
      )
    }
    {
      full && project.paper && (
        <a href={project.paper}>
          Paper <ArrowIcon direction="up-right" />
        </a>
      )
    }
    {
      full && project.report && (
        <a href={project.report}>
          Report <ArrowIcon direction="up-right" />
        </a>
      )
    }
    <a href={project.github}>
      GitHub <ArrowIcon direction="up-right" />
    </a>
  </div>
</article>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: var(--space-4);
    border: 1px solid var(--line-solid);
    border-radius: 8px;
    background: var(--white);
    transition:
      transform 220ms var(--ease-out),
      box-shadow 220ms var(--ease-out),
      border-color 220ms var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .project-card:hover {
      border-color: rgb(20 95 88 / 45%);
      box-shadow: 0 0.75rem 2rem rgb(17 21 19 / 7%);
      transform: translateY(-3px);
    }
  }

  .project-card__tag {
    margin: 0;
    color: var(--teal);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .project-card__title {
    font-size: 1.375rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.2;
  }

  .project-card__body {
    flex-grow: 1;
    margin: 0;
    color: #3d4441;
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .project-card__body p {
    margin-bottom: 0.75rem;
  }

  .project-card__body strong {
    color: var(--ink);
  }

  .project-card--full .project-card__title {
    font-size: 1.5rem;
  }

  .project-card--full .tag-list {
    margin-top: var(--space-3);
  }

  .project-card__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    font-size: 0.9375rem;
    font-weight: 500;
  }

  .project-card__links a {
    display: inline-flex;
    min-height: 44px;
    gap: 0.35rem;
    align-items: center;
    color: var(--teal);
    text-decoration: none;
  }

  .project-card__links a:hover {
    color: var(--teal-dark);
    text-decoration: underline;
  }
</style>
