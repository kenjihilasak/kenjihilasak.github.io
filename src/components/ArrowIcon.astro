---
interface Props {
  direction?: "right" | "up-right" | "down";
}

const { direction = "right" } = Astro.props;
---

{
  direction === "up-right" ? (
    <svg aria-hidden="true" viewBox="0 0 16 16">
      <path d="M4 12 12 4M5 4h7v7" />
    </svg>
  ) : direction === "down" ? (
    <svg aria-hidden="true" viewBox="0 0 16 16">
      <path d="M8 2v11M3.5 8.5 8 13l4.5-4.5" />
    </svg>
  ) : (
    <svg aria-hidden="true" viewBox="0 0 16 16">
      <path d="M2 8h11M8.5 3.5 13 8l-4.5 4.5" />
    </svg>
  )
}

<style>
  svg {
    width: 1em;
    height: 1em;
    fill: none;
    stroke: currentColor;
    stroke-linecap: square;
    stroke-linejoin: miter;
    stroke-width: 1.5;
  }
</style>
