---
import "../styles/global.css";
import { site } from "../data/site";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = `${site.name} — ${site.role}`,
  description = site.description,
  image = `${site.url}/og-image.png`,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, site.url);
const currentPath = Astro.url.pathname;
const nav = [
  { href: "/work/", label: "Projects" },
  { href: "/experience/", label: "Experience" },
  { href: "/publications/", label: "Publications" },
];

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: site.name,
  url: site.url,
  jobTitle: site.role,
  address: {
    "@type": "PostalAddress",
    addressLocality: "Leeds",
    addressCountry: "GB",
  },
  sameAs: [site.github, site.linkedin],
  alumniOf: {
    "@type": "CollegeOrUniversity",
    name: "University of Leeds",
  },
};
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <meta name="theme-color" content="#145f58" />
    <meta name="color-scheme" content="light" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta
      property="og:image:alt"
      content="Kenji Hilasaca — Data & AI Engineer in Leeds, UK"
    />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta
      name="twitter:image:alt"
      content="Kenji Hilasaca — Data & AI Engineer in Leeds, UK"
    />
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(personSchema)}
    />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container site-header__inner">
        <a class="brand" href="/">
          <span class="brand__mark">KH</span>
          <span class="brand__name">Kenji Hilasaca</span>
        </a>
        <nav aria-label="Primary navigation">
          <ul>
            {
              nav.map((item) => (
                <li>
                  <a
                    href={item.href}
                    aria-current={
                      currentPath.startsWith(item.href) ? "page" : undefined
                    }
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">
        <div class="site-footer__bottom">
          <p>© {new Date().getFullYear()} {site.name}</p>
          <p>{site.locationShort}</p>
          <ul>
            <li><a href={site.github}>GitHub</a></li>
            <li><a href={site.linkedin}>LinkedIn</a></li>
            <li><a href={site.cv}>CV</a></li>
          </ul>
        </div>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header {
    border-bottom: 1px solid var(--line-solid);
    background: var(--paper);
  }

  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    min-height: 4.25rem;
    gap: 0.5rem 1.75rem;
    align-items: center;
    padding-block: 0.75rem;
  }

  .brand {
    display: inline-flex;
    gap: 0.625rem;
    align-items: center;
    margin-right: auto;
    color: var(--ink);
    font-weight: 600;
    text-decoration: none;
  }

  .brand:hover {
    color: var(--ink);
  }

  .brand__mark {
    display: grid;
    width: 2.25rem;
    height: 2.25rem;
    place-items: center;
    background: var(--teal);
    color: var(--paper);
    font-size: 0.875rem;
  }

  nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.75rem;
  }

  nav a {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    color: #3d4441;
    font-size: 0.9375rem;
    text-decoration: none;
  }

  nav a:hover,
  nav a[aria-current="page"] {
    color: var(--teal);
  }

  nav a[aria-current="page"] {
    font-weight: 500;
  }

  .site-footer {
    margin-top: var(--space-7);
    border-top: 1px solid var(--line-solid);
    color: var(--muted);
  }

  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem var(--space-5);
    align-items: center;
    padding-block: var(--space-4);
    font-size: 0.875rem;
  }

  .site-footer__bottom p {
    margin: 0;
  }

  .site-footer__bottom ul {
    display: flex;
    gap: var(--space-4);
    margin-left: auto;
  }

  .site-footer__bottom a {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    color: inherit;
  }

  .site-footer__bottom a:hover {
    color: var(--teal);
  }

  @media (max-width: 40rem) {
    .site-header__inner {
      gap: 0 1.25rem;
    }

    nav {
      width: 100%;
    }

    nav ul {
      gap: 0 1.25rem;
    }

    .site-footer__bottom ul {
      margin-left: 0;
    }
  }
</style>
